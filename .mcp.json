{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "firefox",
        "--allow-unrestricted-file-access",
        "--viewport-size",
        "1920,1080"
      ],
      "env": {}
    }
  }
}